<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/sync_tokens.py (tools/fs_palette.py) from the Desktop colour profile TokyoNight.xaml: the Fullscreen equivalent of the same choice of the shared ColorProfile group. Do not edit by hand. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- palette: text, panels, background gradients, hero text, scrims, glass, pills; literal colours on purpose (see tools/fs_palette.py) -->
    <Color x:Key="TextColor">#FFC0CAF5</Color>
    <Color x:Key="TextColorDark">#FFA8B1D8</Color>
    <Color x:Key="ControlBackgroundColor">#FF292E42</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF202230</Color>
    <Color x:Key="OverlayColor">#CC0B0B0F</Color>
    <Color x:Key="SelectionLightColor">#FFA0B8F6</Color>
    <Color x:Key="GlyphColor">#FF7AA2F7</Color>
    <Color x:Key="GlyphLightColor">#FFB9CEFB</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#FFC0CAF5" />
    <SolidColorBrush x:Key="TextBrushDark" Color="#FFA8B1D8" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF292E42" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="#FF202230" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="#FFA0B8F6" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC0B0B0F" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="#FF202230" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#FF7AA2F7" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="#FFB9CEFB" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF7AA2F7" />
    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FF242632" Offset="0" />
            <GradientStop Color="#FF16161E" Offset="1.0" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF242632" Offset="0"/>
        <GradientStop Color="#99181821" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF242632" Offset="0"/>
        <GradientStop Color="#99181821" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- Opacity: the glass of the panels (token glass_fill) -->
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5" Opacity="{DynamicResource FsGlassFillOpacity}">
        <GradientStop Color="#FF292E42" Offset="0" />
        <GradientStop Color="#FF0E1018" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00242632" Offset="0.0" />
        <GradientStop Color="#F016161E" Offset="0.7" />
    </LinearGradientBrush>
    <!-- Lit edge of the menus and dialogs -->
    <LinearGradientBrush x:Key="FsPanelRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99FFFFFF" Offset="0" />
        <GradientStop Color="#22FFFFFF" Offset="0.4" />
        <GradientStop Color="#14FFFFFF" Offset="0.7" />
        <GradientStop Color="#55FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- Text that sits on the artwork of the home page and of the details page -->
    <SolidColorBrush x:Key="FsHeroTextBrush" Color="#FFC0CAF5" />
    <Color x:Key="FsHeroShadowColor">#FF000000</Color>
    <SolidColorBrush x:Key="FsHeroDimBrush" Color="#99C0CAF5" />
    <!-- Scrims that keep the text readable over any artwork (tint = the profile, strength = FsBackgroundDarkness) -->
    <LinearGradientBrush x:Key="FsScrimVerticalBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#990E0E14" Offset="0" />
        <GradientStop Color="#000E0E14" Offset="0.22" />
        <GradientStop Color="#000E0E14" Offset="0.42" />
        <GradientStop Color="#D90E0E14" Offset="0.78" />
        <GradientStop Color="#F20E0E14" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsScrimSideBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#B30E0E14" Offset="0" />
        <GradientStop Color="#000E0E14" Offset="0.55" />
    </LinearGradientBrush>
    <!-- Glass: info tiles, chips, pills, hairlines -->
    <LinearGradientBrush x:Key="FsTileFillBrush" StartPoint="0,0" EndPoint="0,1" Opacity="{DynamicResource FsTileGlassOpacity}">
        <GradientStop Color="#5CFFFFFF" Offset="0" />
        <GradientStop Color="#24FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsTileRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FsHairlineBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="FsChipFillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="FsChipTextBrush" Color="#E6C0CAF5" />
    <SolidColorBrush x:Key="FsPillFillBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="FsPillTextBrush" Color="#FFC0CAF5" />
    <SolidColorBrush x:Key="FsPillPrimaryFillBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="FsPillPrimaryTextBrush" Color="#FF0F0F15" />
    <!-- True on a light profile: accent labels give way to the muted text colour (a pastel accent is unreadable on light glass) -->
    <sys:Boolean x:Key="FsLightProfile">False</sys:Boolean>
</ResourceDictionary>

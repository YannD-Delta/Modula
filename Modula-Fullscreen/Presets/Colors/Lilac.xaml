<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/sync_tokens.py (tools/fs_palette.py) from the Desktop colour profile Lilac.xaml: the Fullscreen equivalent of the same choice of the shared ColorProfile group. Do not edit by hand. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- palette: text, panels, background gradients, hero text, scrims, glass, pills; literal colours on purpose (see tools/fs_palette.py) -->
    <Color x:Key="TextColor">#FF231A3D</Color>
    <Color x:Key="TextColorDark">#FF554E6B</Color>
    <Color x:Key="ControlBackgroundColor">#FFF6F3FC</Color>
    <Color x:Key="ControlBackgroundColorDark">#FFE7E4EF</Color>
    <Color x:Key="OverlayColor">#CCECE9F6</Color>
    <Color x:Key="SelectionLightColor">#FF3D1F74</Color>
    <Color x:Key="GlyphColor">#FF6D28D9</Color>
    <Color x:Key="GlyphLightColor">#FFB28DEB</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#FF231A3D" />
    <SolidColorBrush x:Key="TextBrushDark" Color="#FF554E6B" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFF6F3FC" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="#FFE7E4EF" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="#FF3D1F74" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#CCECE9F6" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="#FFE7E4EF" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#FF6D28D9" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="#FFB28DEB" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF6D28D9" />
    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FFEFECF8" Offset="0" />
            <GradientStop Color="#FFE4DFF2" Offset="1.0" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFEFECF8" Offset="0"/>
        <GradientStop Color="#99E4DFF2" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FFEFECF8" Offset="0"/>
        <GradientStop Color="#99E4DFF2" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- Opacity: the glass of the panels (token glass_fill) -->
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5" Opacity="{DynamicResource FsGlassFillOpacity}">
        <GradientStop Color="#FFF7F4FC" Offset="0" />
        <GradientStop Color="#FFEEEAF8" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00EFECF8" Offset="0.0" />
        <GradientStop Color="#F0E4DFF2" Offset="0.7" />
    </LinearGradientBrush>
    <!-- Lit edge of the menus and dialogs -->
    <LinearGradientBrush x:Key="FsPanelRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#44000000" Offset="0" />
        <GradientStop Color="#0F000000" Offset="0.4" />
        <GradientStop Color="#09000000" Offset="0.7" />
        <GradientStop Color="#26000000" Offset="1" />
    </LinearGradientBrush>
    <!-- Text that sits on the artwork of the home page and of the details page -->
    <SolidColorBrush x:Key="FsHeroTextBrush" Color="#FF231A3D" />
    <Color x:Key="FsHeroShadowColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="FsHeroDimBrush" Color="#B3231A3D" />
    <!-- Scrims that keep the text readable over any artwork (tint = the profile, strength = FsBackgroundDarkness) -->
    <LinearGradientBrush x:Key="FsScrimVerticalBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#99E8E4F4" Offset="0" />
        <GradientStop Color="#00E8E4F4" Offset="0.22" />
        <GradientStop Color="#00E8E4F4" Offset="0.42" />
        <GradientStop Color="#D9E8E4F4" Offset="0.78" />
        <GradientStop Color="#F2E8E4F4" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsScrimSideBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#B3E8E4F4" Offset="0" />
        <GradientStop Color="#00E8E4F4" Offset="0.55" />
    </LinearGradientBrush>
    <!-- Glass: info tiles, chips, pills, hairlines -->
    <LinearGradientBrush x:Key="FsTileFillBrush" StartPoint="0,0" EndPoint="0,1" Opacity="{DynamicResource FsTileGlassOpacity}">
        <GradientStop Color="#A8FFFFFF" Offset="0" />
        <GradientStop Color="#70FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsTileRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40000000" Offset="0" />
        <GradientStop Color="#14000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FsHairlineBrush" Color="#33000000" />
    <SolidColorBrush x:Key="FsChipFillBrush" Color="#3AFFFFFF" />
    <SolidColorBrush x:Key="FsChipTextBrush" Color="#E6231A3D" />
    <SolidColorBrush x:Key="FsPillFillBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="FsPillTextBrush" Color="#FF231A3D" />
    <SolidColorBrush x:Key="FsPillPrimaryFillBrush" Color="#F2231A3D" />
    <SolidColorBrush x:Key="FsPillPrimaryTextBrush" Color="#FFEFECF8" />
    <!-- True on a light profile: accent labels give way to the muted text colour (a pastel accent is unreadable on light glass) -->
    <sys:Boolean x:Key="FsLightProfile">True</sys:Boolean>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/sync_tokens.py (tools/fs_palette.py) from the Desktop colour profile Mist.xaml: the Fullscreen equivalent of the same choice of the shared ColorProfile group. Do not edit by hand. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- palette: text, panels, background gradients, hero text, scrims, glass, pills; literal colours on purpose (see tools/fs_palette.py) -->
    <Color x:Key="TextColor">#FF14202E</Color>
    <Color x:Key="TextColorDark">#FF49535F</Color>
    <Color x:Key="ControlBackgroundColor">#FFF4F7FB</Color>
    <Color x:Key="ControlBackgroundColorDark">#FFE4E8ED</Color>
    <Color x:Key="OverlayColor">#CCE9EFF4</Color>
    <Color x:Key="SelectionLightColor">#FF17306A</Color>
    <Color x:Key="GlyphColor">#FF1D4ED8</Color>
    <Color x:Key="GlyphLightColor">#FF87A1EA</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#FF14202E" />
    <SolidColorBrush x:Key="TextBrushDark" Color="#FF49535F" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFF4F7FB" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="#FFE4E8ED" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="#FF17306A" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#CCE9EFF4" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="#FFE4E8ED" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="#FF87A1EA" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF1D4ED8" />
    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FFECF1F6" Offset="0" />
            <GradientStop Color="#FFE0E8F0" Offset="1.0" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFECF1F6" Offset="0"/>
        <GradientStop Color="#99E0E8F0" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FFECF1F6" Offset="0"/>
        <GradientStop Color="#99E0E8F0" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- Opacity: the glass of the panels (token glass_fill) -->
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5" Opacity="{DynamicResource FsGlassFillOpacity}">
        <GradientStop Color="#FFF5F8FC" Offset="0" />
        <GradientStop Color="#FFEBF0F6" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00ECF1F6" Offset="0.0" />
        <GradientStop Color="#F0E0E8F0" Offset="0.7" />
    </LinearGradientBrush>
    <!-- Lit edge of the menus and dialogs -->
    <LinearGradientBrush x:Key="FsPanelRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#44000000" Offset="0" />
        <GradientStop Color="#0F000000" Offset="0.4" />
        <GradientStop Color="#09000000" Offset="0.7" />
        <GradientStop Color="#26000000" Offset="1" />
    </LinearGradientBrush>
    <!-- Text that sits on the artwork of the home page and of the details page -->
    <SolidColorBrush x:Key="FsHeroTextBrush" Color="#FF14202E" />
    <Color x:Key="FsHeroShadowColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="FsHeroDimBrush" Color="#B314202E" />
    <!-- Scrims that keep the text readable over any artwork (tint = the profile, strength = FsBackgroundDarkness) -->
    <LinearGradientBrush x:Key="FsScrimVerticalBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#99E5EBF2" Offset="0" />
        <GradientStop Color="#00E5EBF2" Offset="0.22" />
        <GradientStop Color="#00E5EBF2" Offset="0.42" />
        <GradientStop Color="#D9E5EBF2" Offset="0.78" />
        <GradientStop Color="#F2E5EBF2" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsScrimSideBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#B3E5EBF2" Offset="0" />
        <GradientStop Color="#00E5EBF2" Offset="0.55" />
    </LinearGradientBrush>
    <!-- Glass: info tiles, chips, pills, hairlines -->
    <LinearGradientBrush x:Key="FsTileFillBrush" StartPoint="0,0" EndPoint="0,1" Opacity="{DynamicResource FsTileGlassOpacity}">
        <GradientStop Color="#A8FFFFFF" Offset="0" />
        <GradientStop Color="#70FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsTileRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40000000" Offset="0" />
        <GradientStop Color="#14000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FsHairlineBrush" Color="#33000000" />
    <SolidColorBrush x:Key="FsChipFillBrush" Color="#3AFFFFFF" />
    <SolidColorBrush x:Key="FsChipTextBrush" Color="#E614202E" />
    <SolidColorBrush x:Key="FsPillFillBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="FsPillTextBrush" Color="#FF14202E" />
    <SolidColorBrush x:Key="FsPillPrimaryFillBrush" Color="#F214202E" />
    <SolidColorBrush x:Key="FsPillPrimaryTextBrush" Color="#FFECF1F6" />
    <!-- True on a light profile: accent labels give way to the muted text colour (a pastel accent is unreadable on light glass) -->
    <sys:Boolean x:Key="FsLightProfile">True</sys:Boolean>
</ResourceDictionary>

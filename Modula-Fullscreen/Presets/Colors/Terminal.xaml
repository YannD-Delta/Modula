<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/sync_tokens.py (tools/fs_palette.py) from the Desktop colour profile Terminal.xaml: the Fullscreen equivalent of the same choice of the shared ColorProfile group. Do not edit by hand. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- palette: text, panels, background gradients, hero text, scrims, glass, pills; literal colours on purpose (see tools/fs_palette.py) -->
    <Color x:Key="TextColor">#FFB9F7BC</Color>
    <Color x:Key="TextColorDark">#FF7DA97F</Color>
    <Color x:Key="ControlBackgroundColor">#FF0F2112</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF0B180D</Color>
    <Color x:Key="OverlayColor">#CC010202</Color>
    <Color x:Key="SelectionLightColor">#FF7FF092</Color>
    <Color x:Key="GlyphColor">#FF39E75F</Color>
    <Color x:Key="GlyphLightColor">#FF96F2AA</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#FFB9F7BC" />
    <SolidColorBrush x:Key="TextBrushDark" Color="#FF7DA97F" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF0F2112" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="#FF0B180D" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="#FF7FF092" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC010202" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="#FF0B180D" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#FF39E75F" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="#FF96F2AA" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF39E75F" />
    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FF101911" Offset="0" />
            <GradientStop Color="#FF020503" Offset="1.0" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF101911" Offset="0"/>
        <GradientStop Color="#99030704" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF101911" Offset="0"/>
        <GradientStop Color="#99030704" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- Opacity: the glass of the panels (token glass_fill) -->
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5" Opacity="{DynamicResource FsGlassFillOpacity}">
        <GradientStop Color="#FF0F2112" Offset="0" />
        <GradientStop Color="#FF030704" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00101911" Offset="0.0" />
        <GradientStop Color="#F0020503" Offset="0.7" />
    </LinearGradientBrush>
    <!-- Lit edge of the menus and dialogs -->
    <LinearGradientBrush x:Key="FsPanelRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99FFFFFF" Offset="0" />
        <GradientStop Color="#22FFFFFF" Offset="0.4" />
        <GradientStop Color="#14FFFFFF" Offset="0.7" />
        <GradientStop Color="#55FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- Text that sits on the artwork of the home page and of the details page -->
    <SolidColorBrush x:Key="FsHeroTextBrush" Color="#FFB9F7BC" />
    <Color x:Key="FsHeroShadowColor">#FF000000</Color>
    <SolidColorBrush x:Key="FsHeroDimBrush" Color="#99B9F7BC" />
    <!-- Scrims that keep the text readable over any artwork (tint = the profile, strength = FsBackgroundDarkness) -->
    <LinearGradientBrush x:Key="FsScrimVerticalBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#99010302" Offset="0" />
        <GradientStop Color="#00010302" Offset="0.22" />
        <GradientStop Color="#00010302" Offset="0.42" />
        <GradientStop Color="#D9010302" Offset="0.78" />
        <GradientStop Color="#F2010302" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsScrimSideBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#B3010302" Offset="0" />
        <GradientStop Color="#00010302" Offset="0.55" />
    </LinearGradientBrush>
    <!-- Glass: info tiles, chips, pills, hairlines -->
    <LinearGradientBrush x:Key="FsTileFillBrush" StartPoint="0,0" EndPoint="0,1" Opacity="{DynamicResource FsTileGlassOpacity}">
        <GradientStop Color="#5CFFFFFF" Offset="0" />
        <GradientStop Color="#24FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsTileRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FsHairlineBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="FsChipFillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="FsChipTextBrush" Color="#E6B9F7BC" />
    <SolidColorBrush x:Key="FsPillFillBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="FsPillTextBrush" Color="#FFB9F7BC" />
    <SolidColorBrush x:Key="FsPillPrimaryFillBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="FsPillPrimaryTextBrush" Color="#FF010402" />
    <!-- True on a light profile: accent labels give way to the muted text colour (a pastel accent is unreadable on light glass) -->
    <sys:Boolean x:Key="FsLightProfile">False</sys:Boolean>
</ResourceDictionary>

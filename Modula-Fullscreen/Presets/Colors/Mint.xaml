<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/sync_tokens.py (tools/fs_palette.py) from the Desktop colour profile Mint.xaml: the Fullscreen equivalent of the same choice of the shared ColorProfile group. Do not edit by hand. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- palette: text, panels, background gradients, hero text, scrims, glass, pills; literal colours on purpose (see tools/fs_palette.py) -->
    <Color x:Key="TextColor">#FF0F2A1E</Color>
    <Color x:Key="TextColorDark">#FF3A5247</Color>
    <Color x:Key="ControlBackgroundColor">#FFF2FAF5</Color>
    <Color x:Key="ControlBackgroundColorDark">#FFE2EBE6</Color>
    <Color x:Key="OverlayColor">#CCE5F3EA</Color>
    <Color x:Key="SelectionLightColor">#FF0B4532</Color>
    <Color x:Key="GlyphColor">#FF047857</Color>
    <Color x:Key="GlyphLightColor">#FF7AB7A6</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#FF0F2A1E" />
    <SolidColorBrush x:Key="TextBrushDark" Color="#FF3A5247" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFF2FAF5" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="#FFE2EBE6" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="#FF0B4532" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#CCE5F3EA" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="#FFE2EBE6" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#FF047857" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="#FF7AB7A6" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF047857" />
    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FFE8F5EE" Offset="0" />
            <GradientStop Color="#FFDAEEE1" Offset="1.0" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFE8F5EE" Offset="0"/>
        <GradientStop Color="#99DAEEE1" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FFE8F5EE" Offset="0"/>
        <GradientStop Color="#99DAEEE1" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- Opacity: the glass of the panels (token glass_fill) -->
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5" Opacity="{DynamicResource FsGlassFillOpacity}">
        <GradientStop Color="#FFF3FAF6" Offset="0" />
        <GradientStop Color="#FFE7F4EC" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00E8F5EE" Offset="0.0" />
        <GradientStop Color="#F0DAEEE1" Offset="0.7" />
    </LinearGradientBrush>
    <!-- Lit edge of the menus and dialogs -->
    <LinearGradientBrush x:Key="FsPanelRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#44000000" Offset="0" />
        <GradientStop Color="#0F000000" Offset="0.4" />
        <GradientStop Color="#09000000" Offset="0.7" />
        <GradientStop Color="#26000000" Offset="1" />
    </LinearGradientBrush>
    <!-- Text that sits on the artwork of the home page and of the details page -->
    <SolidColorBrush x:Key="FsHeroTextBrush" Color="#FF0F2A1E" />
    <Color x:Key="FsHeroShadowColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="FsHeroDimBrush" Color="#B30F2A1E" />
    <!-- Scrims that keep the text readable over any artwork (tint = the profile, strength = FsBackgroundDarkness) -->
    <LinearGradientBrush x:Key="FsScrimVerticalBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#99E0F1E6" Offset="0" />
        <GradientStop Color="#00E0F1E6" Offset="0.22" />
        <GradientStop Color="#00E0F1E6" Offset="0.42" />
        <GradientStop Color="#D9E0F1E6" Offset="0.78" />
        <GradientStop Color="#F2E0F1E6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsScrimSideBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#B3E0F1E6" Offset="0" />
        <GradientStop Color="#00E0F1E6" Offset="0.55" />
    </LinearGradientBrush>
    <!-- Glass: info tiles, chips, pills, hairlines -->
    <LinearGradientBrush x:Key="FsTileFillBrush" StartPoint="0,0" EndPoint="0,1" Opacity="{DynamicResource FsTileGlassOpacity}">
        <GradientStop Color="#A8FFFFFF" Offset="0" />
        <GradientStop Color="#70FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsTileRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40000000" Offset="0" />
        <GradientStop Color="#14000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FsHairlineBrush" Color="#33000000" />
    <SolidColorBrush x:Key="FsChipFillBrush" Color="#3AFFFFFF" />
    <SolidColorBrush x:Key="FsChipTextBrush" Color="#E60F2A1E" />
    <SolidColorBrush x:Key="FsPillFillBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="FsPillTextBrush" Color="#FF0F2A1E" />
    <SolidColorBrush x:Key="FsPillPrimaryFillBrush" Color="#F20F2A1E" />
    <SolidColorBrush x:Key="FsPillPrimaryTextBrush" Color="#FFE8F5EE" />
    <!-- True on a light profile: accent labels give way to the muted text colour (a pastel accent is unreadable on light glass) -->
    <sys:Boolean x:Key="FsLightProfile">True</sys:Boolean>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/sync_tokens.py (tools/fs_palette.py) from the Desktop colour profile Blush.xaml: the Fullscreen equivalent of the same choice of the shared ColorProfile group. Do not edit by hand. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- palette: text, panels, background gradients, hero text, scrims, glass, pills; literal colours on purpose (see tools/fs_palette.py) -->
    <Color x:Key="TextColor">#FF3A1D26</Color>
    <Color x:Key="TextColorDark">#FF5F464D</Color>
    <Color x:Key="ControlBackgroundColor">#FFFDF3F5</Color>
    <Color x:Key="ControlBackgroundColorDark">#FFEFE4E7</Color>
    <Color x:Key="OverlayColor">#CCF7E9EC</Color>
    <Color x:Key="SelectionLightColor">#FF681B39</Color>
    <Color x:Key="GlyphColor">#FFBE185D</Color>
    <Color x:Key="GlyphLightColor">#FFDD85A9</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#FF3A1D26" />
    <SolidColorBrush x:Key="TextBrushDark" Color="#FF5F464D" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFDF3F5" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="#FFEFE4E7" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="#FF681B39" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#CCF7E9EC" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="#FFEFE4E7" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#FFBE185D" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="#FFDD85A9" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FFBE185D" />
    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FFFAEDEF" Offset="0" />
            <GradientStop Color="#FFF4E0E4" Offset="1.0" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFFAEDEF" Offset="0"/>
        <GradientStop Color="#99F4E0E4" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FFFAEDEF" Offset="0"/>
        <GradientStop Color="#99F4E0E4" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- Opacity: the glass of the panels (token glass_fill) -->
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5" Opacity="{DynamicResource FsGlassFillOpacity}">
        <GradientStop Color="#FFFEF4F6" Offset="0" />
        <GradientStop Color="#FFF9EAEE" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00FAEDEF" Offset="0.0" />
        <GradientStop Color="#F0F4E0E4" Offset="0.7" />
    </LinearGradientBrush>
    <!-- Lit edge of the menus and dialogs -->
    <LinearGradientBrush x:Key="FsPanelRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#44000000" Offset="0" />
        <GradientStop Color="#0F000000" Offset="0.4" />
        <GradientStop Color="#09000000" Offset="0.7" />
        <GradientStop Color="#26000000" Offset="1" />
    </LinearGradientBrush>
    <!-- Text that sits on the artwork of the home page and of the details page -->
    <SolidColorBrush x:Key="FsHeroTextBrush" Color="#FF3A1D26" />
    <Color x:Key="FsHeroShadowColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="FsHeroDimBrush" Color="#B33A1D26" />
    <!-- Scrims that keep the text readable over any artwork (tint = the profile, strength = FsBackgroundDarkness) -->
    <LinearGradientBrush x:Key="FsScrimVerticalBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#99F6E5E8" Offset="0" />
        <GradientStop Color="#00F6E5E8" Offset="0.22" />
        <GradientStop Color="#00F6E5E8" Offset="0.42" />
        <GradientStop Color="#D9F6E5E8" Offset="0.78" />
        <GradientStop Color="#F2F6E5E8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsScrimSideBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#B3F6E5E8" Offset="0" />
        <GradientStop Color="#00F6E5E8" Offset="0.55" />
    </LinearGradientBrush>
    <!-- Glass: info tiles, chips, pills, hairlines -->
    <LinearGradientBrush x:Key="FsTileFillBrush" StartPoint="0,0" EndPoint="0,1" Opacity="{DynamicResource FsTileGlassOpacity}">
        <GradientStop Color="#A8FFFFFF" Offset="0" />
        <GradientStop Color="#70FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsTileRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40000000" Offset="0" />
        <GradientStop Color="#14000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FsHairlineBrush" Color="#33000000" />
    <SolidColorBrush x:Key="FsChipFillBrush" Color="#3AFFFFFF" />
    <SolidColorBrush x:Key="FsChipTextBrush" Color="#E63A1D26" />
    <SolidColorBrush x:Key="FsPillFillBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="FsPillTextBrush" Color="#FF3A1D26" />
    <SolidColorBrush x:Key="FsPillPrimaryFillBrush" Color="#F23A1D26" />
    <SolidColorBrush x:Key="FsPillPrimaryTextBrush" Color="#FFFAEDEF" />
    <!-- True on a light profile: accent labels give way to the muted text colour (a pastel accent is unreadable on light glass) -->
    <sys:Boolean x:Key="FsLightProfile">True</sys:Boolean>
</ResourceDictionary>

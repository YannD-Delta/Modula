<?xml version="1.0" encoding="utf-8"?>
<!-- Fullscreen typography preset Editorial: Georgia, a serif for a magazine feel. Merged live over the theme like a colour profile; only fonts that ship with Windows. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontTitilliumWebLight">Georgia</FontFamily>
    <FontFamily x:Key="FontTitilliumWeb">Georgia</FontFamily>
    <FontFamily x:Key="FontTitilliumWebBold">Georgia Bold</FontFamily>
    <FontFamily x:Key="FsHtmlFontFamily">Georgia</FontFamily>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<!-- Fullscreen typography preset Soft: Corbel, rounded humanist. Merged live over the theme like a colour profile; only fonts that ship with Windows. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontTitilliumWebLight">Corbel</FontFamily>
    <FontFamily x:Key="FontTitilliumWeb">Corbel</FontFamily>
    <FontFamily x:Key="FontTitilliumWebBold">Corbel Bold</FontFamily>
    <FontFamily x:Key="FsHtmlFontFamily">Corbel</FontFamily>
</ResourceDictionary>

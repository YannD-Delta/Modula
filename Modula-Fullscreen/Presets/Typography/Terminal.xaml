<?xml version="1.0" encoding="utf-8"?>
<!-- Fullscreen typography preset Terminal: Consolas, monospaced. Merged live over the theme like a colour profile; only fonts that ship with Windows. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontTitilliumWebLight">Consolas</FontFamily>
    <FontFamily x:Key="FontTitilliumWeb">Consolas</FontFamily>
    <FontFamily x:Key="FontTitilliumWebBold">Consolas Bold</FontFamily>
    <FontFamily x:Key="FsHtmlFontFamily">Consolas</FontFamily>
</ResourceDictionary>

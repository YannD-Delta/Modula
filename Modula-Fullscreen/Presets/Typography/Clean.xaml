<?xml version="1.0" encoding="utf-8"?>
<!-- Fullscreen typography preset Clean: Segoe UI, semibold for titles. Merged live over the theme like a colour profile; only fonts that ship with Windows. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontTitilliumWebLight">Segoe UI</FontFamily>
    <FontFamily x:Key="FontTitilliumWeb">Segoe UI</FontFamily>
    <FontFamily x:Key="FontTitilliumWebBold">Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="FsHtmlFontFamily">Segoe UI</FontFamily>
</ResourceDictionary>

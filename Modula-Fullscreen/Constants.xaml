<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="GlyphColor">#FF4DA3FF</Color>
    <Color x:Key="GlyphLightColor">#FF9AD1FF</Color>
    <Color x:Key="SelectionLightColor">#FF9FB4D6</Color>
    <Color x:Key="OverlayColor">#CC050A18</Color>
    
    <Color x:Key="ControlBackgroundColor">#FF1E2A44</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF0E1424</Color>

    <Color x:Key="TextColor">#FFF2F6FF</Color>
    <Color x:Key="TextColorDark">#FF8E9BB5</Color>

    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="{DynamicResource GlyphLightColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="{DynamicResource SelectionLightColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />

    <sys:Double x:Key="FontSizeSmall">18</sys:Double>
    <sys:Double x:Key="FontSize">22</sys:Double>

    <sys:Double x:Key="FilterPanelWidth">300</sys:Double>
    
    <GridLength x:Key="ProgressWindowWidth">640</GridLength>
    
    <Style x:Key="TextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWebLight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FF14224A" Offset="0" />
            <GradientStop Color="#FF070B17" Offset="1.0" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5" >
        <GradientStop Color="#FF14224A" Offset="0"/>
        <GradientStop Color="#990A1226" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1" >
        <GradientStop Color="#FF14224A" Offset="0"/>
        <GradientStop Color="#990A1226" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5" >
        <GradientStop Color="#FF14224A" Offset="0"/>
        <GradientStop Color="#FF040716" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Solid on purpose: a brush whose Color reads GlyphColor is rebuilt live when the accent changes (gradient stops are not) -->
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource GlyphColor}" />

    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4" >
        <GradientStop Color="#0014224A" Offset="0.0"/>
        <GradientStop Color="#F0070B17" Offset="0.7"/>
    </LinearGradientBrush>
    
    <!-- Layout Studio (Fullscreen): the values the quick menu and the editor change. Cards, focus ring, tiles, buttons. -->
    <CornerRadius x:Key="FsCardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="FsCardRimCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="FsCoverCornerRadius">22</CornerRadius>
    <CornerRadius x:Key="FsTileCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="FsButtonCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="FsPanelCornerRadius">24</CornerRadius>
    <sys:Double x:Key="FsFocusGlowOpacity">0.9</sys:Double>
    <sys:Double x:Key="FsFocusGlowBlur">26</sys:Double>
    <Thickness x:Key="FsFocusRingThickness">3</Thickness>
    <sys:Double x:Key="FsGlassRimOpacity">1</sys:Double>
    <sys:Double x:Key="FsTitleStripOpacity">1</sys:Double>
    <sys:Double x:Key="FsTileGlassOpacity">1</sys:Double>

    <!-- Lit edge of the menus and dialogs: bright top-left, dim middle -->
    <LinearGradientBrush x:Key="FsPanelRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99FFFFFF" Offset="0" />
        <GradientStop Color="#22FFFFFF" Offset="0.4" />
        <GradientStop Color="#14FFFFFF" Offset="0.7" />
        <GradientStop Color="#55FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Horizontal layout: height of the band that holds the row of covers, and the space the text keeps above it -->
    <sys:Double x:Key="FsRowHeight">470</sys:Double>
    <Thickness x:Key="FsHeroMargin">110,0,110,500</Thickness>

    <!-- Info cells of the details page: the same card numbers and constants as the desktop theme (0 = nothing). Up to four cards share one cell. -->
    <sys:Int32 x:Key="HeaderTileSlot1">1</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot1B">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot1C">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot1D">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot2">2</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot2B">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot2C">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot2D">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot3">13</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot3B">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot3C">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot3D">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot4">15</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot4B">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot4C">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot4D">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot5">8</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot5B">31</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot5C">32</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot5D">33</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot6">6</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot6B">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot6C">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot6D">0</sys:Int32>

    <SolidColorBrush x:Key="WarningBrush" Color="#ff6b6b" />
</ResourceDictionary>
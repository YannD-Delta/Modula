<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="GlyphColor">#FF4DA3FF</Color>
    <Color x:Key="GlyphLightColor">#FF9AD1FF</Color>
    <!-- BEGIN palette -->
    <!-- generated by tools/sync_tokens.py (tools/fs_palette.py): the default palette; do not edit by hand -->
    <!-- palette: text, panels, background gradients, hero text, scrims, glass, pills; literal colours on purpose (see tools/fs_palette.py) -->
    <Color x:Key="TextColor">#FFF2F6FF</Color>
    <Color x:Key="TextColorDark">#FF8E9BB5</Color>
    <Color x:Key="ControlBackgroundColor">#FF1E2A44</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF0E1424</Color>
    <Color x:Key="OverlayColor">#CC050A18</Color>
    <Color x:Key="SelectionLightColor">#FF9FB4D6</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#FFF2F6FF" />
    <SolidColorBrush x:Key="TextBrushDark" Color="#FF8E9BB5" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF1E2A44" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="#FF0E1424" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="#FF9FB4D6" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC050A18" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="#FF0E1424" />
    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FF14224A" Offset="0" />
            <GradientStop Color="#FF070B17" Offset="1.0" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF14224A" Offset="0"/>
        <GradientStop Color="#990A1226" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF14224A" Offset="0"/>
        <GradientStop Color="#990A1226" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- Opacity: the glass of the panels (token glass_fill) -->
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5" Opacity="{DynamicResource FsGlassFillOpacity}">
        <GradientStop Color="#FF14224A" Offset="0" />
        <GradientStop Color="#FF040716" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#0014224A" Offset="0.0" />
        <GradientStop Color="#F0070B17" Offset="0.7" />
    </LinearGradientBrush>
    <!-- Lit edge of the menus and dialogs -->
    <LinearGradientBrush x:Key="FsPanelRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99FFFFFF" Offset="0" />
        <GradientStop Color="#22FFFFFF" Offset="0.4" />
        <GradientStop Color="#14FFFFFF" Offset="0.7" />
        <GradientStop Color="#55FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- Text that sits on the artwork of the home page and of the details page -->
    <SolidColorBrush x:Key="FsHeroTextBrush" Color="#FFF2F6FF" />
    <Color x:Key="FsHeroShadowColor">#FF000000</Color>
    <SolidColorBrush x:Key="FsHeroDimBrush" Color="#99F2F6FF" />
    <!-- Scrims that keep the text readable over any artwork (tint = the profile, strength = FsBackgroundDarkness) -->
    <LinearGradientBrush x:Key="FsScrimVerticalBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#99050810" Offset="0" />
        <GradientStop Color="#00050810" Offset="0.22" />
        <GradientStop Color="#00050810" Offset="0.42" />
        <GradientStop Color="#D9050810" Offset="0.78" />
        <GradientStop Color="#F2050810" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsScrimSideBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#B3050810" Offset="0" />
        <GradientStop Color="#00050810" Offset="0.55" />
    </LinearGradientBrush>
    <!-- Glass: info tiles, chips, pills, hairlines -->
    <LinearGradientBrush x:Key="FsTileFillBrush" StartPoint="0,0" EndPoint="0,1" Opacity="{DynamicResource FsTileGlassOpacity}">
        <GradientStop Color="#5CFFFFFF" Offset="0" />
        <GradientStop Color="#24FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FsTileRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FsHairlineBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="FsChipFillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="FsChipTextBrush" Color="#E6F2F6FF" />
    <SolidColorBrush x:Key="FsPillFillBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="FsPillTextBrush" Color="#FFF2F6FF" />
    <SolidColorBrush x:Key="FsPillPrimaryFillBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="FsPillPrimaryTextBrush" Color="#FF050810" />
    <!-- True on a light profile: accent labels give way to the muted text colour (a pastel accent is unreadable on light glass) -->
    <sys:Boolean x:Key="FsLightProfile">False</sys:Boolean>
    <!-- END palette -->
    

    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="{DynamicResource GlyphLightColor}" />

    <sys:Double x:Key="FontSizeSmall">18</sys:Double>
    <sys:Double x:Key="FontSize">22</sys:Double>

    <sys:Double x:Key="FilterPanelWidth">300</sys:Double>
    
    <GridLength x:Key="ProgressWindowWidth">640</GridLength>
    
    <Style x:Key="TextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWebLight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>


    <!-- Solid on purpose: a brush whose Color reads GlyphColor is rebuilt live when the accent changes (gradient stops are not) -->
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource GlyphColor}" />

    
    <!-- Layout Studio (Fullscreen): the values the quick menu and the editor change. Cards, focus ring, tiles, buttons. -->
    <sys:Double x:Key="FsFocusGlowBlur">26</sys:Double>
    <Thickness x:Key="FsFocusRingThickness">3</Thickness>
    <!-- BEGIN tokens -->
    <!-- generated by tools/sync_tokens.py from docs/plans/theme-sync-tokens.yaml: Desktop default x scale; do not edit by hand -->
    <CornerRadius x:Key="FsCardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="FsCardRimCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="FsPanelCornerRadius">24</CornerRadius>
    <CornerRadius x:Key="FsSideRightCornerRadius">0,24,24,0</CornerRadius>
    <CornerRadius x:Key="FsTileCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="FsButtonCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="FsPillCornerRadius">40</CornerRadius>
    <CornerRadius x:Key="FsPillRingCornerRadius">42</CornerRadius>
    <CornerRadius x:Key="FsCoverCornerRadius">22</CornerRadius>
    <CornerRadius x:Key="FsChipCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="FsControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="FsPopupCornerRadius">20</CornerRadius>
    <sys:Double x:Key="FsGlassRimOpacity">1</sys:Double>
    <sys:Double x:Key="FsGlassFillOpacity">0.92</sys:Double>
    <sys:Double x:Key="FsTileGlassOpacity">0.5</sys:Double>
    <sys:Double x:Key="FsFocusGlowOpacity">0.9</sys:Double>
    <sys:Double x:Key="FsPopupShadowOpacity">0.55</sys:Double>
    <sys:Double x:Key="FsBackgroundDarkness">1</sys:Double>
    <!-- END tokens -->
    <!-- Safe area: the margin every text edge of the home page keeps from the screen border (TVs crop the borders of the picture) -->
    <Thickness x:Key="FsSafeInset">110,0,110,0</Thickness>
    <!-- Margin of the row of covers inside the screen: FsSafeInset minus the room a cover keeps around itself (the SafeArea preset sets both together) -->
    <Thickness x:Key="FsShelfInset">25,0,25,0</Thickness>
    <!-- Selected-game block of the home page (the Layout preset changes these) -->
    <sys:Double x:Key="FsHeroTitleSize">72</sys:Double>
    <sys:Double x:Key="FsHeroLineSize">28</sys:Double>
    <Visibility x:Key="FsHeroVisibility">Visible</Visibility>
    <!-- Details page: widest the info tiles and the buttons may grow (an ultra-wide screen keeps a readable block) -->
    <sys:Double x:Key="FsDetailsTextMaxWidth">1500</sys:Double>
    <!-- Family of the description text of the details page (HtmlTextView reads a system font name, not the embedded Titillium) -->
    <FontFamily x:Key="FsHtmlFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="FsTitleStripOpacity">1</sys:Double>
    <!-- Motion preset: False = no arrival animation of the cards on the home row -->
    <sys:Boolean x:Key="FsMotionOn">True</sys:Boolean>
    <!-- Sound preset: False = the theme's own interface sounds are silent (Playnite's navigation sounds follow its own volume setting) -->
    <sys:Boolean x:Key="FsSoundOn">True</sys:Boolean>

    <!-- Add-on integrations (each one hides itself and takes no room when its add-on is missing; these switches only turn an integration off on purpose) -->
    <!-- Trailer of the Extra Metadata Loader behind the details page (Visible / Collapsed). The Performance preset collapses it (a video costs GPU and bandwidth). -->
    <Visibility x:Key="FsDetailsVideoVisibility">Visible</Visibility>
    <!-- Status chips of the top bar: controller battery, Wi-Fi, volume, game running -->
    <Visibility x:Key="FsStatusChipsVisibility">Visible</Visibility>
    <!-- Library facts and the suggested game of the optional Aniki Helper add-on, on the right of the title block -->
    <Visibility x:Key="FsLibraryFactsVisibility">Visible</Visibility>

    <!-- Horizontal layout: height of the band that holds the row of covers, and the space the text keeps above it (the left and right edges are FsSafeInset) -->
    <sys:Double x:Key="FsRowHeight">470</sys:Double>
    <Thickness x:Key="FsHeroMargin">0,0,0,500</Thickness>

    <!-- Info cells of the details page: the same card numbers and constants as the desktop theme (0 = nothing). Up to four cards share one cell. -->
    <sys:Int32 x:Key="HeaderTileSlot1">1</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot1B">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot1C">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot1D">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot2">2</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot2B">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot2C">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot2D">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot3">13</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot3B">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot3C">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot3D">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot4">15</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot4B">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot4C">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot4D">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot5">8</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot5B">31</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot5C">32</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot5D">33</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot6">6</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot6B">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot6C">0</sys:Int32>
    <sys:Int32 x:Key="HeaderTileSlot6D">0</sys:Int32>

    <SolidColorBrush x:Key="WarningBrush" Color="#ff6b6b" />
    <!--
        Add-on integrations of the Fullscreen theme: styles shared by the home page and the details page (kept in Constants.xaml because Playnite only loads the view files it knows by name).
        Rules (the same as the Desktop theme): every binding to an add-on has a literal FallbackValue; an element that has nothing to show is Collapsed (no space,
        no dialog, no error); an add-on is never required. Property names are the ones the add-ons publish for themes (their own documentation).
        Status chips (top bar): Segoe MDL2 Assets glyphs (shipped with Windows), muted text, no frame.
    -->

    <Style x:Key="FsStatusGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource FsHeroTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FsStatusText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource FsHeroTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- A chip that shows when its Tag is True (a boolean the add-on publishes); the switch FsStatusChipsVisibility sits on the container of the chips -->
    <Style x:Key="FsStatusChipWhenTrue" TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Margin" Value="0,0,26,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A chip that shows unless its Tag (a text the add-on publishes, literal FallbackValue '') is empty or null -->
    <Style x:Key="FsStatusChipWhenText" TargetType="Border">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="Margin" Value="0,0,26,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Glass card of the Aniki Helper facts (home page, right of the title block) -->
    <Style x:Key="FsFactCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource FsTileCornerRadius}" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource OverlayMenuBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FsPanelRimBrush}" />
        <Setter Property="MinWidth" Value="380" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
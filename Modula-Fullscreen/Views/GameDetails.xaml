    <Style TargetType="{x:Type GameDetails}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameDetails}">
                    <ControlTemplate.Resources>
                        <!-- The page builds itself in (flag FsMotionOn, preset Motion): started by a trigger on the flag, not on Loaded, so Off leaves everything in place -->
                        <Storyboard x:Key="FsPageIn">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MediaRow" Storyboard.TargetProperty="Opacity">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.42" Value="0" />
                            <EasingDoubleKeyFrame KeyTime="0:0:0.86" Value="1">
                                <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MediaRow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="22" />
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.42" Value="22" />
                            <EasingDoubleKeyFrame KeyTime="0:0:0.92" Value="0">
                                <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CoverHost" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.40" Value="1">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CoverHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-48" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="-48" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.50" Value="0">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TitleText" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="1">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TitleText" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="22" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="22" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.58" Value="0">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChipsRow" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="0" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.52" Value="1">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChipsRow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="22" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="22" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.62" Value="0">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetName="PART_ImageBackground" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.1" Duration="0:0:45">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="PART_ImageBackground" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.1" Duration="0:0:45">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TilesRow1" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.16" Value="0" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.56" Value="1">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TilesRow1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="22" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.16" Value="22" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.66" Value="0">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ButtonsRow" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.28" Value="0" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.68" Value="1">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ButtonsRow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="22" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.28" Value="22" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.78" Value="0">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ScrollHtmlDescription" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.34" Value="0" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.74" Value="1">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ScrollHtmlDescription" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="22" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.34" Value="22" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.84" Value="0">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid Background="{DynamicResource MainBackgourndBrush}"
                          x:Name="PART_ViewHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="350" />
                            <ColumnDefinition Width="6*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2.4*" />
                            <RowDefinition Height="4*" />
                        </Grid.RowDefinitions>
                        <!-- The page builds itself in each time it is loaded (the Motion preset does not stop this one: a trigger on the Motion flag never started the storyboard on the testbed) -->
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard Storyboard="{StaticResource FsPageIn}" />
                            </EventTrigger>
                        </Grid.Triggers>
                        <Border x:Name="MotionFlag" Width="0" Height="0" IsHitTestVisible="False" Tag="{DynamicResource FsMotionOn}" />
                        <!-- The page sound: Playnite's interface volume; muted by the Sound preset Off (IsMuted comes from the style, never set locally) -->
                        <MediaElement Source="{ThemeFile 'audio/_details-in.wav'}" LoadedBehavior="Play" UnloadedBehavior="Close"
                                      Volume="{Settings Fullscreen.InterfaceVolume}" Tag="{DynamicResource FsSoundOn}" Width="0" Height="0" IsHitTestVisible="False">
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False"><Setter Property="IsMuted" Value="True" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>
                        <!-- Slow zoom on the artwork while the page is open (see the storyboard above) -->
                        <FadeImage HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Grid.ColumnSpan="4" Grid.RowSpan="2"
                                   RenderTransformOrigin="0.5,0.35"
                                   x:Name="PART_ImageBackground">
                            <FadeImage.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></FadeImage.RenderTransform>
                        </FadeImage>

                        <!-- Trailer (Extra Metadata Loader) behind the page: only when the add-on has one for this game, the window is active (an inactive window
                             stops showing it) and the switch FsDetailsVideoVisibility is on; the Performance preset collapses it -->
                        <Grid Grid.ColumnSpan="4" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="{DynamicResource FsDetailsVideoVisibility}">
                            <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControl_NoControls_Sound" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                            Tag="{PluginSettings Plugin=ExtraMetadataLoader, Path=NewContextVideoAvailable, FallbackValue=False}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    <Condition Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=True}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>

                        <Border Background="{DynamicResource GameDetailsBackgroundBrush}"
                                Grid.ColumnSpan="4" Grid.Row="1" />

                        <!-- Content block: same safe inset as the home page, cover then text (the colour profile decides every colour) -->
                        <Grid Grid.ColumnSpan="4" Grid.Row="1" Margin="{DynamicResource FsSafeInset}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="350" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Rounded cover with a glass edge and a soft shadow -->
                            <Grid x:Name="CoverHost" Grid.Column="0" Margin="0,14,28,14" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                                <Border CornerRadius="{DynamicResource FsCoverCornerRadius}" Background="Black" Opacity="0.55" Margin="2,10,2,-6">
                                    <Border.Effect>
                                        <BlurEffect Radius="24" RenderingBias="Performance" />
                                    </Border.Effect>
                                </Border>
                                <Grid Opacity="0" IsHitTestVisible="False">
                                    <Border x:Name="CoverMask" Background="Black" CornerRadius="{DynamicResource FsCoverCornerRadius}" />
                                </Grid>
                                <Grid>
                                    <Grid.OpacityMask>
                                        <VisualBrush Visual="{Binding ElementName=CoverMask}" />
                                    </Grid.OpacityMask>
                                    <Border Background="{DynamicResource ControlBackgroundDarkBrush}" />
                                    <Image x:Name="PART_ImageCover" />
                                </Grid>
                                <Border CornerRadius="{DynamicResource FsCoverCornerRadius}" BorderThickness="1.5" IsHitTestVisible="False" BorderBrush="{DynamicResource FsTileRimBrush}" />
                            </Grid>

                            <Image Grid.Column="0"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Margin="14,28,28,28"
                                   Source="{Binding LibraryPlugin.LibraryIcon}"
                                   Height="48" RenderOptions.BitmapScalingMode="Fant">
                                <Image.Effect>
                                    <DropShadowEffect Color="White" BlurRadius="20" ShadowDepth="0"
                                                      RenderingBias="Quality" Opacity="1"/>
                                </Image.Effect>
                            </Image>

                            <DockPanel Grid.Column="1"
                                       Margin="20"
                                       HorizontalAlignment="Left">

                                <!-- Game logo (Extra Metadata Loader): shown instead of the name when the add-on has one -->
                                <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl" DockPanel.Dock="Top" HorizontalAlignment="Left" MaxHeight="120" MaxWidth="560"
                                                Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,0,0,6"
                                                Tag="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <TextBlock x:Name="TitleText"
                                           Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource FsHeroTextBrush}" FontFamily="{DynamicResource FontTitilliumWebBold}"
                                           FontSize="42" DockPanel.Dock="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=ExtraMetadataLoader_LogoLoaderControl}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="2" Color="{DynamicResource FsHeroShadowColor}"
                                                          RenderingBias="Quality" Opacity="1"/>
                                    </TextBlock.Effect>
                                </TextBlock>

                                <!-- Genre chips: glass pills under the title (corners: FsChipCornerRadius) -->
                                <ItemsControl x:Name="ChipsRow" DockPanel.Dock="Top" ItemsSource="{Binding Genres}" Focusable="False" IsTabStop="False"
                                              IsHitTestVisible="False" Margin="0,14,0,0" MaxWidth="{DynamicResource FsDetailsTextMaxWidth}">
                                    <ItemsControl.RenderTransform><TranslateTransform /></ItemsControl.RenderTransform>
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="{DynamicResource FsChipCornerRadius}" Padding="18,5" Margin="0,0,10,8" BorderThickness="1" BorderBrush="{DynamicResource FsHairlineBrush}" Background="{DynamicResource FsChipFillBrush}">
                                                <TextBlock Style="{DynamicResource TextBlockBaseStyle}" Text="{Binding Name}" FontSize="22" Foreground="{DynamicResource FsChipTextBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <WrapPanel x:Name="TilesRow1" Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,20,0,6" MaxWidth="{DynamicResource FsDetailsTextMaxWidth}">
                                    <WrapPanel.RenderTransform><TranslateTransform /></WrapPanel.RenderTransform>
                                <!-- BEGIN generated cells -->
                            <Border Margin="0,0,14,14">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FsTileBorder}">
                                        <Setter Property="Margin" Value="0,0,14,14" />
                                        <Style.Triggers>
                                            <!-- no card of this cell has anything to show: the cell leaves no box and no gap -->
                                            <DataTrigger Binding="{Binding ActualWidth, ElementName=Cell1Cards}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel x:Name="Cell1Cards" Orientation="Horizontal">
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot1}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot1B}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot1C}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot1D}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,14,14">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FsTileBorder}">
                                        <Setter Property="Margin" Value="0,0,14,14" />
                                        <Style.Triggers>
                                            <!-- no card of this cell has anything to show: the cell leaves no box and no gap -->
                                            <DataTrigger Binding="{Binding ActualWidth, ElementName=Cell2Cards}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel x:Name="Cell2Cards" Orientation="Horizontal">
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot2}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot2B}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot2C}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot2D}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,14,14">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FsTileBorder}">
                                        <Setter Property="Margin" Value="0,0,14,14" />
                                        <Style.Triggers>
                                            <!-- no card of this cell has anything to show: the cell leaves no box and no gap -->
                                            <DataTrigger Binding="{Binding ActualWidth, ElementName=Cell3Cards}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel x:Name="Cell3Cards" Orientation="Horizontal">
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot3}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot3B}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot3C}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot3D}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,14,14">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FsTileBorder}">
                                        <Setter Property="Margin" Value="0,0,14,14" />
                                        <Style.Triggers>
                                            <!-- no card of this cell has anything to show: the cell leaves no box and no gap -->
                                            <DataTrigger Binding="{Binding ActualWidth, ElementName=Cell4Cards}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel x:Name="Cell4Cards" Orientation="Horizontal">
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot4}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot4B}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot4C}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot4D}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,14,14">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FsTileBorder}">
                                        <Setter Property="Margin" Value="0,0,14,14" />
                                        <Style.Triggers>
                                            <!-- no card of this cell has anything to show: the cell leaves no box and no gap -->
                                            <DataTrigger Binding="{Binding ActualWidth, ElementName=Cell5Cards}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel x:Name="Cell5Cards" Orientation="Horizontal">
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot5}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot5B}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot5C}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot5D}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,14,14">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FsTileBorder}">
                                        <Setter Property="Margin" Value="0,0,14,14" />
                                        <Style.Triggers>
                                            <!-- no card of this cell has anything to show: the cell leaves no box and no gap -->
                                            <DataTrigger Binding="{Binding ActualWidth, ElementName=Cell6Cards}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel x:Name="Cell6Cards" Orientation="Horizontal">
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot6}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot6B}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot6C}" />
                                <ContentControl Style="{StaticResource CardHost}" Tag="{DynamicResource HeaderTileSlot6D}" />
                                </StackPanel>
                            </Border>
                            <!-- END generated cells -->
                                </WrapPanel>

                                <StackPanel x:Name="ButtonsRow" Orientation="Horizontal" DockPanel.Dock="Top">
                                    <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                                    <ButtonEx x:Name="PART_ButtonContext" Style="{StaticResource FsPillPrimary}" />
                                    <ButtonEx x:Name="PART_ButtonOptions" Style="{StaticResource FsPillButton}"
                                              Content="{DynamicResource LOCGameOptions}" />
                                    <ButtonEx x:Name="FsButtonBackNowPlaying" Style="{StaticResource FsPillBackToGame}" Content="{DynamicResource LOCHNDFsBackToGame}"
                                              Command="{PluginSettings Plugin=NowPlaying, Path=ReturnToGame, FallbackValue={x:Null}}"
                                              Tag="{PluginSettings Plugin=NowPlaying, Path=IsGameRunning, FallbackValue=False}" />
                                    <ButtonEx x:Name="FsButtonBackBackToGame" Style="{StaticResource FsPillBackToGame}" Content="{DynamicResource LOCHNDFsBackToGame}"
                                              Command="{PluginSettings Plugin=BackToGame, Path=ActivateGame, FallbackValue={x:Null}}"
                                              Tag="{PluginSettings Plugin=BackToGame, Path=IsRunning, FallbackValue=False}" />
                                </StackPanel>

                                <!-- Media row: the screenshots found for the game (Screenshot Utilities' folders, read by Layout Studio); collapses when there are none -->
                                <ItemsControl x:Name="MediaRow" DockPanel.Dock="Bottom" Margin="0,16,0,0" Height="136" MaxWidth="{DynamicResource FsDetailsTextMaxWidth}" ClipToBounds="True"
                                              Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                              ItemsSource="{PluginSettings Plugin=LayoutStudio, Path=Media.Screenshots}"
                                              Tag="{PluginSettings Plugin=LayoutStudio, Path=Media.HasScreenshots}">
                                    <ItemsControl.RenderTransform><TranslateTransform /></ItemsControl.RenderTransform>
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="242" Height="136" Margin="0,0,14,0">
                                                <Grid Opacity="0" IsHitTestVisible="False">
                                                    <Border x:Name="ShotMask" Background="Black" CornerRadius="{DynamicResource FsTileCornerRadius}" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.OpacityMask><VisualBrush Visual="{Binding ElementName=ShotMask}" /></Grid.OpacityMask>
                                                    <Border Background="{DynamicResource ControlBackgroundDarkBrush}" />
                                                    <Image Source="{Binding Converter={StaticResource ImageStringToImageConverter}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                                                </Grid>
                                                <Border CornerRadius="{DynamicResource FsTileCornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource FsHairlineBrush}" IsHitTestVisible="False" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ScrollViewerEx Margin="0,20,0,0" DockPanel.Dock="Top"
                                                x:Name="PART_ScrollHtmlDescription"
                                                VerticalScrollBarVisibility="Hidden"
                                                CustomScrollAmount="42">
                                    <ScrollViewerEx.RenderTransform><TranslateTransform /></ScrollViewerEx.RenderTransform>
                                    <HtmlTextView x:Name="PART_HtmlDescription"
                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                  HtmlFontFamily="{DynamicResource FsHtmlFontFamily}"
                                                  HtmlForeground="{DynamicResource TextColor}"
                                                  LinkForeground="{DynamicResource GlyphColor}"
                                                  FocusVisualStyle="{x:Null}" />
                                </ScrollViewerEx>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

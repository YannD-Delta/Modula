                            <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                            <Border CornerRadius="{DynamicResource FsCoverCornerRadius}" Background="Black" Opacity="0.55" Margin="2,10,2,-6">
                                <Border.Effect>
                                    <BlurEffect Radius="24" RenderingBias="Performance" />
                                </Border.Effect>
                            </Border>
                            <Grid Opacity="0" IsHitTestVisible="False">
                                <Border x:Name="CoverMask" Background="Black" CornerRadius="{DynamicResource FsCoverCornerRadius}" />
                            </Grid>
                            <Grid>
                                <Grid.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=CoverMask}" />
                                </Grid.OpacityMask>
                                <Border Background="{DynamicResource ControlBackgroundDarkBrush}" />
                                <Image x:Name="PART_ImageCover" />
                            </Grid>
                            <Border CornerRadius="{DynamicResource FsCoverCornerRadius}" BorderThickness="1.5" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#99FFFFFF" Offset="0" />
                                        <GradientStop Color="#18FFFFFF" Offset="0.6" />
                                        <GradientStop Color="#44FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                        </Grid>


<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- Info tile: label over value on a glass card. Collapses when the value is empty. -->
    <Style x:Key="FsTileBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource FsTileCornerRadius}" />
        <Setter Property="Opacity" Value="{DynamicResource FsTileGlassOpacity}" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2EFFFFFF" Offset="0" />
                    <GradientStop Color="#12FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#66FFFFFF" Offset="0" />
                    <GradientStop Color="#14FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FsTileLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWebBold}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphLightBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- PlayStation-style action pills: Play is a solid white pill, the others are glass -->
    <Style x:Key="FsPillButton" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="Padding" Value="44,14" />
        <Setter Property="Margin" Value="0,2,14,2" />
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Grid>
                        <Border x:Name="Pill" CornerRadius="40" Background="{TemplateBinding Background}" BorderBrush="#55FFFFFF" BorderThickness="1" />
                        <TextBlock Style="{DynamicResource TextBlockBaseStyle}" Foreground="{TemplateBinding Foreground}" FontFamily="{DynamicResource FontTitilliumWebBold}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </TextBlock>
                        <Border x:Name="Ring" CornerRadius="42" Margin="-4" BorderThickness="3" BorderBrush="{DynamicResource SelectionBrush}" Visibility="Hidden" IsHitTestVisible="False">
                            <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="22" Opacity="0.8" Color="{DynamicResource GlyphColor}" RenderingBias="Performance" /></Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.16" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.16" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FsPillPrimary" TargetType="ButtonEx" BasedOn="{StaticResource FsPillButton}">
        <Setter Property="Background" Value="#F2FFFFFF" />
        <Setter Property="Foreground" Value="#0B0F1A" />
    </Style>


<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- Accent label (tile labels, genre line; defined here because a view cannot use a BasedOn style that only Constants.xaml has: the views load first): the light end of the accent on a dark profile, the muted text colour on a light profile (FsLightProfile, see tools/fs_palette.py) -->
    <Style x:Key="FsAccentLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource GlyphLightBrush}" />
        <Setter Property="Tag" Value="{DynamicResource FsLightProfile}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Info tile: label over value on a glass card. Collapses when the value is empty. -->
    <Style x:Key="FsTileBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource FsTileCornerRadius}" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- glass and edge come from the colour profile (FsTileFillBrush, FsTileRimBrush) -->
        <Setter Property="Background" Value="{DynamicResource FsTileFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FsTileRimBrush}" />
    </Style>

    <Style x:Key="FsTileLabel" TargetType="TextBlock" BasedOn="{StaticResource FsAccentLabelStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWebBold}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- PlayStation-style action pills: Play is a solid white pill, the others are glass -->
    <Style x:Key="FsPillButton" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource FsPillTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource FsPillFillBrush}" />
        <Setter Property="Padding" Value="44,14" />
        <Setter Property="Margin" Value="0,2,28,2" />
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Grid>
                        <Border x:Name="Pill" CornerRadius="{DynamicResource FsPillCornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource FsHairlineBrush}" BorderThickness="1" />
                        <TextBlock Style="{DynamicResource TextBlockBaseStyle}" Foreground="{TemplateBinding Foreground}" FontFamily="{DynamicResource FontTitilliumWebBold}" FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </TextBlock>
                        <Border x:Name="Ring" CornerRadius="{DynamicResource FsPillRingCornerRadius}" Margin="-4" BorderThickness="3" BorderBrush="{DynamicResource SelectionBrush}" Visibility="Hidden" IsHitTestVisible="False">
                            <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="22" Opacity="0.8" Color="{DynamicResource GlyphColor}" RenderingBias="Performance" /></Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.16" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.16" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FsPillPrimary" TargetType="ButtonEx" BasedOn="{StaticResource FsPillButton}">
        <Setter Property="Background" Value="{DynamicResource FsPillPrimaryFillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FsPillPrimaryTextBrush}" />
        <!-- the big Play button of the console details page -->
        <Setter Property="FontSize" Value="34" />
        <Setter Property="Padding" Value="70,18" />
        <Setter Property="MinWidth" Value="380" />
    </Style>

    <!-- "Back to game" pills (Now Playing, Back To Game): Collapsed (no room) until the add-on reports a running game -->
    <Style x:Key="FsPillBackToGame" TargetType="ButtonEx" BasedOn="{StaticResource FsPillButton}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


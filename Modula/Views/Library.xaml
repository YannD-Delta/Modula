<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="Yellow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid d:DesignWidth="1500" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <!-- Window glass: the selected game's artwork (Playnite fills PART_ImageBackground), blurred and dimmed behind the whole window.
                             The bleed pushes the blur's soft edges out of view and extends the layer under the sidebar.
                             Blur and darkness: WindowGlassBlurRadius / WindowGlassScrimOpacity. The blur is cached at a reduced scale so it is only computed when the image changes. -->
                        <Grid x:Name="WindowGlass" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" IsHitTestVisible="False"
                              Opacity="{DynamicResource WindowGlassOpacity}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Tag" Value="{DynamicResource WindowGlassEnabled}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="false">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid Margin="{DynamicResource WindowGlassBleed}">
                                <!-- The blur sits on a CHILD of the cached element: an Effect on the cached element itself is run again at every repaint of the
                                     window (measured: 13 % of the GPU while the game list scrolls, 2 % with the effect inside the cache, same pixels). -->
                                <Grid>
                                    <Grid.CacheMode>
                                        <BitmapCache EnableClearType="False" RenderAtScale="0.25" SnapsToDevicePixels="False" />
                                    </Grid.CacheMode>
                                    <Grid>
                                        <Grid.Effect>
                                            <BlurEffect Radius="{DynamicResource WindowGlassBlurRadius}" KernelType="Gaussian" RenderingBias="Performance" />
                                        </Grid.Effect>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                                <Border Background="Black" Opacity="{DynamicResource WindowGlassScrimOpacity}" />
                            </Grid>
                        </Grid>

                        <TopPanel DockPanel.Dock="Top" Grid.Row="0" />

                        <!-- Warning: the glass is fed by Playnite's "Show background image on the window". It shows only while that setting is OFF and the glass is ON
                             (and WindowGlassBackgroundWarning allows it); it never takes a click. -->
                        <FrameworkElement x:Name="GlassWarningProbe" Visibility="Collapsed" Tag="{DynamicResource WindowGlassBackgroundWarning}" />
                        <Border x:Name="GlassBackgroundWarning" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,24,0"
                                Padding="14,8,14,9" IsHitTestVisible="False" Panel.ZIndex="50" MaxWidth="640"
                                Tag="{DynamicResource WindowGlassEnabled}"
                                Background="#E61B1E24" BorderBrush="#FFE0A030" BorderThickness="1" CornerRadius="{DynamicResource HeroChipCornerRadius}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="False" />
                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding Tag, ElementName=GlassWarningProbe}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{DynamicResource LOCHNDGlassBackgroundWarning}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="#FFF1E3C4" FontSize="{DynamicResource FontSize}" FontFamily="{DynamicResource FontFamily}" />
                        </Border>

                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource PanelSeparatorBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Left">
                                            <Setter Property="BorderThickness" Value="1,1,0,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                                            <Setter Property="BorderThickness" Value="0,1,1,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                                            <Setter Property="BorderThickness" Value="0,1,0,1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <DockPanel>
                                <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}"/>

                                <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                           DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}"/>

                                <Grid DockPanel.Dock="Left">
                                    <LibraryDetailsView x:Name="PART_ViewDetails" />
                                    <LibraryGridView x:Name="PART_ViewGrid" />
                                    <LibraryListView x:Name="PART_ViewList" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
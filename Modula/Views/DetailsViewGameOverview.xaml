                                            <Grid Grid.Column="1" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=LayoutStudio, Path=Options[DetailsViewShowEditButton], FallbackValue={StaticResource DetailsViewShowEditButton}, TargetNullValue={StaticResource DetailsViewShowEditButton}}">

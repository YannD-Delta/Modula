                                                        Height="{PluginSettings Plugin=LayoutStudio, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" Width="{PluginSettings Plugin=LayoutStudio, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" />
                                            </Grid>
                                            <Grid Grid.Column="2" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=LayoutStudio, Path=Options[DetailsViewShowFavoriteButton], FallbackValue={StaticResource DetailsViewShowFavoriteButton}, TargetNullValue={StaticResource DetailsViewShowFavoriteButton}}">

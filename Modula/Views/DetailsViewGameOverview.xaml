                                                                <DataTrigger Binding="{Binding Game.Tags}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Grid Tag="{PluginSettings Plugin=LayoutStudio, Path=Options[DetailsViewExpandTags], FallbackValue={StaticResource DetailsViewExpandTags}, TargetNullValue={StaticResource DetailsViewExpandTags}}">
                                                        <ToggleButton x:Name="DetailsViewTagsPanelToggleButtonRight" MinHeight="{PluginSettings Plugin=LayoutStudio, Path=Options[SectionHeaderMinHeight], FallbackValue={StaticResource SectionHeaderMinHeight}, TargetNullValue={StaticResource SectionHeaderMinHeight}}" Margin="{DynamicResource SectionHeaderMargin}" Focusable="False">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource DetailsSectionHeaderToggleButton}">
                                                                    <!-- WPF only accepts Binding or DynamicResource as a setter value: read the live option from the header Grid Tag -->
                                                                    <Setter Property="IsChecked" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}, Mode=OneWay}" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{PluginSettings Plugin=LayoutStudio, Path=Options[DemoteSectionsShownElsewhere], FallbackValue={StaticResource DemoteSectionsShownElsewhere}, TargetNullValue={StaticResource DemoteSectionsShownElsewhere}}" Value="True" />
                                                                                <Condition Binding="{PluginSettings Plugin=LayoutStudio, Path=Options[DemoteTagsSection], FallbackValue={StaticResource DemoteTagsSection}, TargetNullValue={StaticResource DemoteTagsSection}}" Value="True" />
                                                                                <Condition Binding="{PluginSettings Plugin=LayoutStudio, Path=Options[HeroShowInfoLine], FallbackValue={StaticResource HeroShowInfoLine}, TargetNullValue={StaticResource HeroShowInfoLine}}" Value="True" />
                                                                                <Condition Binding="{Binding Tag, ElementName=HeroInfoLineStyleProbe}" Value="True" />
                                                                                <Condition Binding="{PluginSettings Plugin=LayoutStudio, Path=Options[HeroShowTags], FallbackValue={StaticResource HeroShowTags}, TargetNullValue={StaticResource HeroShowTags}}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="IsChecked" Value="False" />
                                                                            <Setter Property="Opacity" Value="0.55" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                            <Label Content="{DynamicResource LOCTagsLabel}" Style="{DynamicResource FeedSectionLabel}" Margin="0" />
                                                        </ToggleButton>
                                                        <!-- Quick settings: where and how this section shows, applied at once through Theme Options -->
                                                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{DynamicResource SectionGearMargin}" Height="{PluginSettings Plugin=LayoutStudio, Path=Options[SectionHeaderMinHeight], FallbackValue={StaticResource SectionHeaderMinHeight}, TargetNullValue={StaticResource SectionHeaderMinHeight}}">
                                                            <Button x:Name="QuickSettingsTagsRight" Style="{DynamicResource SectionQuickSettingsButton}" VerticalAlignment="Center"
                                                                    Command="{PluginSettings Plugin=LayoutStudio, Path=OpenEditor, FallbackValue={x:Null}}"
                                                                    CommandParameter="visual-sections" />
                                                        </Grid>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,10" MinHeight="{PluginSettings Plugin=LayoutStudio, Path=Options[SectionContainerMinHeight], FallbackValue={StaticResource SectionContainerMinHeight}, TargetNullValue={StaticResource SectionContainerMinHeight}}">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=DetailsViewTagsPanelToggleButtonRight}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Border Style="{DynamicResource OutlineBorderSidePanelsBorder}" />
                                                        <Border Style="{DynamicResource OutlineBorder}" />
                                                        <ItemsControl ItemsSource="{Binding Game.Tags}" Margin="{DynamicResource SectionChipsMargin}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="{Binding Name}" Style="{StaticResource PropertyItemFeedPanelButton}"
                                                                        Command="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=DataContext.SetTagFilterCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </StackPanel>
                                                </Grid>

                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>


                        </Grid>
                    </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

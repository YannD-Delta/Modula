    <!-- Tag = Visibility of PART_ButtonContextAction: the button takes the context colors when it is shown. -->
    <Style x:Key="HeroMoreActionsButton" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="{DynamicResource HeroActionButtonHeight}" />
        <Setter Property="Width" Value="{DynamicResource HeroActionButtonHeight}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource PlayButtonMoreBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#55FFFFFF" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Part" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" CornerRadius="{DynamicResource HeroButtonCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" TargetName="Part" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PlayButtonIsMouseOverBackgroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Visible">
                <Setter Property="Background" Value="{DynamicResource MoreButtonNotInstalledBackgroundBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Visible" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource MoreButtonNotInstalledIsMouseOverBackgroundBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeroIconActionButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="{DynamicResource HeroActionButtonHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource HeroActionButtonHeight}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="Foreground" Value="{DynamicResource HeroSecondaryButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource HeroSecondaryButtonBackgroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Grid x:Name="Bloom" Opacity="0" IsHitTestVisible="False" Margin="{DynamicResource GlassGlowMargin}">
                            <Border Background="{DynamicResource GlyphBrush}" Opacity="{DynamicResource GlassGlowOpacity}"
                                    OpacityMask="{DynamicResource GlassGlowMask}" CornerRadius="{DynamicResource HeroButtonCornerRadius}" />
                        </Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource HeroButtonCornerRadius}" />
                        <Border Background="{DynamicResource GlassGlossBrush}" Opacity="0.5" IsHitTestVisible="False" CornerRadius="{DynamicResource HeroButtonCornerRadius}" />
                        <Border x:Name="Wash" Background="{DynamicResource GlassHoverFillBrush}" Opacity="0" IsHitTestVisible="False" CornerRadius="{DynamicResource HeroButtonCornerRadius}" />
                        <Border BorderBrush="{DynamicResource GlassRimBrush}" BorderThickness="{DynamicResource GlassRimThickness}"
                                IsHitTestVisible="False" CornerRadius="{DynamicResource HeroButtonCornerRadius}" />
                        <Border x:Name="RimHover" BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="{DynamicResource GlassRimThickness}" Opacity="0"
                                IsHitTestVisible="False" CornerRadius="{DynamicResource HeroButtonCornerRadius}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- M:base -->
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="RimHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- M:slow -->
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.30" />
                                        <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.30" />
                                        <DoubleAnimation Storyboard.TargetName="RimHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.30" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.34">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.34">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" TargetName="Root" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon toggle: Content is the unchecked glyph, Tag the checked glyph (heart by default) -->
    <Style x:Key="HeroFavoriteToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Content" Value="&#xE734;" />
        <Setter Property="Tag" Value="&#xE735;" />
        <Setter Property="Width" Value="{DynamicResource HeroActionButtonHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource HeroActionButtonHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource HeroSecondaryButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource HeroSecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HeroSecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Part" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" CornerRadius="{DynamicResource HeroButtonCornerRadius}">
                        <TextBlock x:Name="Icon" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="18" FontWeight="Normal"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Icon" Property="Text" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="Part" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HeroSecondaryButtonHoverBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Chip on the artwork: dark glass (the artwork behind is sharp, so the fill stays darker than on the page), rim, hover lift -->
    <Style x:Key="HeroInfoChip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource HeroSecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassRimBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource GlassRimThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource HeroChipCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource HeroChipPadding}" />
        <Setter Property="Margin" Value="{DynamicResource HeroChipSpacing}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HeroSecondaryButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlassRimHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeroInfoChipText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource HeroChipFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource WeightValue}" />
        <Setter Property="Foreground" Value="{DynamicResource HeroChipTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HeroInfoChipLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource HeroChipFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource WeightLabel}" />
        <Setter Property="Foreground" Value="{DynamicResource HeroChipLabelBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!--
        Fade and slide in when the selected game changes (Binding.TargetUpdated).
        The element must carry its own local TranslateTransform: a transform set by a style
        setter is frozen and cannot be animated.
    -->
    <Style x:Key="HeroFadeInStyle" TargetType="{x:Type FrameworkElement}">
        <Style.Triggers>
            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="16" To="0" Duration="0:0:0.45">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>
    <!-- END generated hero styles -->
</ResourceDictionary>

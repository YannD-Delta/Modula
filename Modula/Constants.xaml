    <sys:Double x:Key="HeroPlayersCountFontSize">28</sys:Double>
    <!-- Set by presets only (presets must not set variables) -->
    <sys:Boolean x:Key="HeroStyleShowInfoLine">True</sys:Boolean>
    <sys:Boolean x:Key="HeaderBarStyleVisible">True</sys:Boolean>
    <!-- Artwork card (2.7): spacing around the card, corners and outline -->
    <Thickness x:Key="HeroCardMargin">20,16,20,0</Thickness>
    <CornerRadius x:Key="HeroCardCornerRadius">26</CornerRadius>
    <Thickness x:Key="HeroCardBorderThickness">1</Thickness>
    <sys:Double x:Key="HeroCardBorderOpacity">0.7</sys:Double>
    <!-- Where the artwork starts fading into the page (1 = no fade, used by the card) -->
    <sys:Double x:Key="HeroFadeStart">1</sys:Double>
    <!-- Progressive blur: two blurred copies of the artwork faded in between Start, Mid and Full (0 = top, 1 = bottom) -->
    <sys:Double x:Key="HeroBlurOpacity">1</sys:Double>
    <sys:Double x:Key="HeroBlurRadiusSoft">10</sys:Double>
    <sys:Double x:Key="HeroBlurRadius">34</sys:Double>
    <sys:Double x:Key="HeroBlurStart">0.4</sys:Double>
    <sys:Double x:Key="HeroBlurMid">0.6</sys:Double>
    <sys:Double x:Key="HeroBlurFull">0.88</sys:Double>
    <!-- Tint over the blurred band: accent color and white frost -->
    <sys:Double x:Key="HeroTintAccentOpacity">0.24</sys:Double>
    <sys:Double x:Key="HeroTintLightOpacity">0.06</sys:Double>
    <!-- Cover in the header: 0 = over the card edge and the tiles row, 1 = inside the card, 2 = hidden -->
    <sys:Int32 x:Key="HeroCoverPlacement">0</sys:Int32>
    <sys:Boolean x:Key="InfoPanelStyleShowCover">False</sys:Boolean>
    <!-- Header bar items drawn as tiles (transparent tile and 20 px gap = classic bar) -->
    <sys:Double x:Key="HeaderRowBackgroundOpacity">0</sys:Double>
    <!-- Edges of the bands behind the header row (blurred artwork, glass, row band): 0 = square edges, 1 = fade out at both sides, 2 = fade out on every edge. Set by the "Band edges" preset. -->
    <sys:Int32 x:Key="HeaderBandEdge">1</sys:Int32>
    <LinearGradientBrush x:Key="HeaderBandFadeSides" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#FF000000" Offset="0.08" />
        <GradientStop Color="#FF000000" Offset="0.92" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderBandFadeTopBottom" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#FF000000" Offset="0.3" />
        <GradientStop Color="#FF000000" Offset="0.7" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <Thickness x:Key="HeaderRowPadding">0,16,0,18</Thickness>
    <sys:Double x:Key="HeaderTileBackgroundOpacity">0.14</sys:Double>
    <!-- Tile color follows the text color of the color profile -->
    <CornerRadius x:Key="HeaderTileCornerRadius">16</CornerRadius>
    <!-- Liquid glass page: blurred artwork fixed behind the page, under an accent tint and a dark scrim -->
    <sys:Double x:Key="PageGlassOpacity">1</sys:Double>
    <sys:Double x:Key="PageGlassBlurRadius">40</sys:Double>
    <sys:Double x:Key="PageGlassScrimOpacity">0.45</sys:Double>
    <sys:Double x:Key="PageGlassTintOpacity">0.1</sys:Double>
    <!-- Window glass: the selected game's artwork, blurred and dimmed behind the whole window (sidebar, top panel, side panels, page).
         WindowGlassEnabled turns it on; the page glass above is then hidden because the window glass replaces it.
         The four panel opacities (top bar, left icon bar, game list, filter panel) are the opacity of each panel's own background (1 = opaque, lower = the artwork shows through, so the zone looks lighter or darker). -->
    <sys:Boolean x:Key="WindowGlassEnabled">True</sys:Boolean>
    <!-- Notice under the top bar when the glass is on but Playnite's "Show background image on the window" is off (the glass would have no artwork) -->
    <sys:Boolean x:Key="WindowGlassBackgroundWarning">True</sys:Boolean>
    <sys:Double x:Key="WindowGlassOpacity">1</sys:Double>
    <!-- Colors of the layers that dim or lift the artwork. Black and white on a dark profile; a light color profile sets light ones, so its window stays pastel and its dark text stays readable. -->
    <Color x:Key="WindowGlassScrimColor">#000000</Color>
    <SolidColorBrush x:Key="WindowGlassScrimBrush" Color="{DynamicResource WindowGlassScrimColor}" />
    <Color x:Key="PageGlassScrimColor">#000000</Color>
    <SolidColorBrush x:Key="PageGlassScrimBrush" Color="{DynamicResource PageGlassScrimColor}" />
    <Color x:Key="HeroShadeColor">#000000</Color>
    <SolidColorBrush x:Key="HeroShadeBrush" Color="{DynamicResource HeroShadeColor}" />
    <Color x:Key="HeroTintLightColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="HeroTintLightBrush" Color="{DynamicResource HeroTintLightColor}" />
    <Color x:Key="HeroBaseColor">#141414</Color>
    <SolidColorBrush x:Key="HeroBaseBrush" Color="{DynamicResource HeroBaseColor}" />
    <!-- Text and glyphs drawn over the artwork or on a pale-on-dark surface. These defaults are the colors the theme always had; a light color profile redefines them in ink. -->
    <Color x:Key="HeroTitleShadowColor">#000000</Color>
    <SolidColorBrush x:Key="HeroTitleBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeroChipTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeroChipLabelBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="HeroFavoriteOffBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="HeroSecondaryButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LibraryDetailsViewInstalledForegroundBrush" Color="#F1F7FF" />
    <SolidColorBrush x:Key="GroupCountForegroundBrush" Color="#A5A7A9" />
    <SolidColorBrush x:Key="TopPanelToggleBackgroundBrush" Color="#25272D" />
    <SolidColorBrush x:Key="TopPanelToggleForegroundBrush" Color="#808080" />
    <SolidColorBrush x:Key="DetailsHyperlinkForegroundBrush" Color="LightGray" />
    <SolidColorBrush x:Key="DetailsHyperlinkHoverForegroundBrush" Color="#FFFFFF" />
    <sys:Double x:Key="WindowGlassBlurRadius">36</sys:Double>
    <sys:Double x:Key="WindowGlassScrimOpacity">0.42</sys:Double>
    <sys:Double x:Key="TopPanelGlassOpacity">0.34</sys:Double>
    <sys:Double x:Key="SidebarGlassOpacity">0.34</sys:Double>
    <sys:Double x:Key="LibraryPanelGlassOpacity">0.3</sys:Double>
    <sys:Double x:Key="FilterPanelGlassOpacity">0.3</sys:Double>
    <!-- Frost over the filter panel and the explorer panel: the section glass fill, so they read as glass slabs over the window artwork instead of flat blocks -->
    <sys:Double x:Key="SidePanelFrostOpacity">0</sys:Double>
    <LinearGradientBrush x:Key="SidePanelFrostBrush" StartPoint="0.5,0" EndPoint="0.5,1" Opacity="{DynamicResource SidePanelFrostOpacity}">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#8CFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <Thickness x:Key="WindowGlassBleed">-60</Thickness>

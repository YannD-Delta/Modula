    <!--Hides a section when its ThemeModifier option (stored in Tag) is False-->
    <Style x:Key="SectionToggleGrid" TargetType="Grid">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">

    <BitmapImage x:Key="HndHelpImageHeaderBar_Default" UriSource="{ThemeFile 'Presets/Previews/HeaderBar_Default.png'}" CacheOption="OnLoad" CreateOptions="DelayCreation" />
    <BitmapImage x:Key="HndHelpImageHeroCover_Default" UriSource="{ThemeFile 'Presets/Previews/HeroCover_Default.png'}" CacheOption="OnLoad" CreateOptions="DelayCreation" />
    <BitmapImage x:Key="HndHelpImageHeroCover_Hidden" UriSource="{ThemeFile 'Presets/Previews/HeroCover_Hidden.png'}" CacheOption="OnLoad" CreateOptions="DelayCreation" />
    <BitmapImage x:Key="HndHelpImageHeroCover_Inside" UriSource="{ThemeFile 'Presets/Previews/HeroCover_Inside.png'}" CacheOption="OnLoad" CreateOptions="DelayCreation" />
    <BitmapImage x:Key="HndHelpImageHeroCover_InsideKeepPanel" UriSource="{ThemeFile 'Presets/Previews/HeroCover_InsideKeepPanel.png'}" CacheOption="OnLoad" CreateOptions="DelayCreation" />
    <DataTemplate x:Key="THICKNESS_PanelTemplate">
        <DockPanel Margin="0,-6,0,12" Background="Transparent" ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="60000">
            <DockPanel.ToolTip>
                <ToolTip MaxWidth="440">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        <Image MaxWidth="400" Margin="0,8,0,0" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Preview}" Value="Buttons_Default">
                                            <Setter Property="Source" Value="{DynamicResource HndHelpImageButtons_Default}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Preview}" Value="Chips_Default">
                                            <Setter Property="Source" Value="{DynamicResource HndHelpImageChips_Default}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Preview}" Value="HeaderBar_Bar">
                                            <Setter Property="Source" Value="{DynamicResource HndHelpImageHeaderBar_Bar}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Preview}" Value="HeaderBar_Default">
                                            <Setter Property="Source" Value="{DynamicResource HndHelpImageHeaderBar_Default}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Preview}" Value="HeroCover_Default">
                                            <Setter Property="Source" Value="{DynamicResource HndHelpImageHeroCover_Default}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Preview}" Value="HeroCover_Hidden">
                                            <Setter Property="Source" Value="{DynamicResource HndHelpImageHeroCover_Hidden}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Preview}" Value="HeroCover_Inside">
                                            <Setter Property="Source" Value="{DynamicResource HndHelpImageHeroCover_Inside}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Preview}" Value="HeroCover_InsideKeepPanel">
                                            <Setter Property="Source" Value="{DynamicResource HndHelpImageHeroCover_InsideKeepPanel}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </StackPanel>
                </ToolTip>
            </DockPanel.ToolTip>
            <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="9" Margin="28,0,8,0" VerticalAlignment="Center"
                    BorderThickness="1.5" BorderBrush="{DynamicResource GlyphBrush}">
                <TextBlock Text="?" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GlyphBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Opacity="0.65" VerticalAlignment="Center" />
        </DockPanel>
    </DataTemplate>

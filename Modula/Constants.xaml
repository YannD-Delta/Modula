    <sys:Double x:Key="HeaderBarGlassOpacity">0</sys:Double>
    <sys:Boolean x:Key="HeroShowInfoLine">True</sys:Boolean>
    <!-- The UniPlaySong player in the banner (UPS_MediaControllerBar), off by default: UniPlaySong already puts play/pause/next in the top bar. Hidden when the extension is missing or nothing plays. -->
    <sys:Boolean x:Key="HeroShowMusicPlayer">False</sys:Boolean>
    <sys:Boolean x:Key="UseImageRotater">True</sys:Boolean>
    <!-- Steam players online (News Viewer control), large above the banner cover. Hidden when False; the control stays empty for games without a Steam page. -->

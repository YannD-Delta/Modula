<?xml version="1.0" encoding="utf-8"?>
<!-- Typography preset, loaded by Theme Options like a color profile. Neon Night: Bahnschrift (SemiBold and Bold named instances), Segoe UI fallback. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontFamily">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyDisplay">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyOverline">Bahnschrift, Segoe UI</FontFamily>
    <x:Static x:Key="WeightDisplay" Member="FontWeights.Bold" />
    <x:Static x:Key="WeightSection" Member="FontWeights.SemiBold" />
    <x:Static x:Key="WeightValue" Member="FontWeights.SemiBold" />
    <x:Static x:Key="WeightLabel" Member="FontWeights.Normal" />
    <x:Static x:Key="WeightButton" Member="FontWeights.Bold" />
</ResourceDictionary>

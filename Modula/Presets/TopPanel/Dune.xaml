<?xml version="1.0" encoding="utf-8"?>
<!--
    Top panel preset: Dune Rev layout (MIT, hugsyf and sakasakiking), loaded by Theme Options
    instead of the Neon top panel. Logo and search on the left, view buttons centered with the
    filter, extension buttons, notifications and progress on the right, transparent background.
    The theme workshop block between the markers is generated by tools/build_options.py.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <TextBlock Text="&#xe9e9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <TextBlock Text="&#xe1cb;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <TextBlock Text="&#xe12f;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <TextBlock Text="&#xec8f;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelViewSelectionTemplate">
        <TextBlock Text="&#xe8a9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <TextBlock Text="&#xe145;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <TextBlock Text="&#xf0e2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <TextBlock Text="&#xe292;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <TextBlock Text="&#xe118;" Foreground="OrangeRed" FontWeight="Bold" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <TextBlock Text="&#xe128;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <TextBlock Text="&#xed59;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <TextBlock Text="&#xe14b;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <TextBlock Text="&#xe773;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <!-- Dune top panel buttons: soft hover background and an accent line under the active view -->
    <Style TargetType="{x:Type TopPanelItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanelItem}">
                    <Grid Height="{TemplateBinding Height}" MinWidth="{TemplateBinding Height}">
                        <Border x:Name="HoverBg" Background="White" Opacity="0" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="SelectedBg" Background="White" Opacity="0.08" Visibility="Collapsed" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Viewbox Width="20" Height="20" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </Viewbox>
                        <Border x:Name="SelectionIndicator" Width="16" Height="2" CornerRadius="1" VerticalAlignment="Bottom"
                                Background="{DynamicResource GlyphBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsToggled" Value="True">
                            <Setter TargetName="SelectedBg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Border Height="{PluginSettings Plugin=LayoutStudio, Path=Options[TopPanelHeight], FallbackValue={StaticResource TopPanelHeight}, TargetNullValue={StaticResource TopPanelHeight}}"
                            Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- left: menu, search, back and forward -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Image Source="{ThemeFile 'Images/applogo.png'}" Height="36" RenderOptions.BitmapScalingMode="Fant" Margin="16,0,0,0" />
                                </Border>
                                <SearchBox x:Name="PART_TextMainSearch"
                                           Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}"
                                           Margin="16,6,8,6" VerticalAlignment="Center"
                                           WindowChrome.IsHitTestVisibleInChrome="True"
                                           Width="{PluginSettings Plugin=LayoutStudio, Path=Options[TopPanelSearchBoxWidthHelium], FallbackValue={StaticResource TopPanelSearchBoxWidthHelium}, TargetNullValue={StaticResource TopPanelSearchBoxWidthHelium}}"
                                           MaxWidth="{Settings DetailsListWitdh}" />
                                <Border Tag="{PluginSettings Plugin=LayoutStudio, Path=Options[ShowNavigationButtons], FallbackValue={StaticResource ShowNavigationButtons}, TargetNullValue={StaticResource ShowNavigationButtons}}" VerticalAlignment="Center"
                                        Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin}" Orientation="Horizontal">
                                        <Button Style="{DynamicResource TopPanelNavigateBackButtonStyle}" Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.BackCommand, FallbackValue={x:Null}}" />
                                        <Button Style="{DynamicResource TopPanelNavigateForwardButtonStyle}" Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.ForwardCommand, FallbackValue={x:Null}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- center: theme settings, view buttons, filter -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Theme settings: opens Theme Options through ThemeExtras -->
                                <Button Style="{DynamicResource TopPanelThemeSettingsButtonStyle}" ToolTip="{DynamicResource LOCHNDThemeSettingsTooltip}"
                                        Margin="{Binding ElementName=PART_ToggleNotifications, Path=Margin}" VerticalAlignment="Center"
                                        Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.OpenPluginSettingsCommand, FallbackValue={x:Null}}"
                                        CommandParameter="904cbf3b-573f-48f8-9642-0a09d05c64ef"
                                        Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin, Status=Installed}" />
                                <!-- PlayniteAchievements: library collection level, opens the achievements overview -->
                                <Grid Style="{DynamicResource SectionToggleGrid}" VerticalAlignment="Center"
                                      Tag="{PluginSettings Plugin=LayoutStudio, Path=Options[TopPanelShowCollectorLevel], FallbackValue={StaticResource TopPanelShowCollectorLevel}, TargetNullValue={StaticResource TopPanelShowCollectorLevel}}">
                                    <Button Style="{DynamicResource TopPanelCollectorButtonStyle}"
                                            Tag="{PluginSettings Plugin=PlayniteAchievements, Path=CollectorLevel, FallbackValue=0}"
                                            ToolTip="{DynamicResource LOCHNDCollectorTooltip}"
                                            Command="{PluginSettings Plugin=PlayniteAchievements, Path=OpenAchievementWindow, FallbackValue={x:Null}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{DynamicResource FontIcoFont}" Text="&#xEDD7;" FontSize="15" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource GlyphBrush}" />
                                                <TextBlock Text="{DynamicResource LOCHNDCollectorLevel}" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=CollectorLevel, FallbackValue=0}" Margin="3,0,0,0"
                                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ProgressBar Height="2" Margin="0,3,0,0" Minimum="0" Maximum="100" IsHitTestVisible="False"
                                                         Value="{PluginSettings Plugin=PlayniteAchievements, Path=CollectorLevelProgress, FallbackValue=0}"
                                                         Foreground="{DynamicResource GlyphBrush}" Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <!-- Add-on chips (Now Playing, AnikiHelper library overview): each one hides itself, and takes no room, without its add-on -->
                                <ContentControl Style="{DynamicResource TopPanelNowPlayingChip}" />
                                <ContentControl Style="{DynamicResource TopPanelLibraryOverview}" />
                                <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="4,6,0,6" />
                                <Border Width="1" Height="20" Margin="8,0,0,0" Background="{DynamicResource PanelSeparatorBrush}" VerticalAlignment="Center" />
                                <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}" Margin="8,0,0,0"
                                          Style="{DynamicResource TopPanelFilterToggle}" />
                            </StackPanel>

                            <!-- right: extension buttons, notifications, progress -->
                            <DockPanel Grid.Column="2" Margin="0,0,120,0">
                                <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="8,6,8,6"
                                            DockPanel.Dock="{Settings PluginTopPanelAlignment}" />
                                <CheckBox x:Name="PART_ToggleNotifications" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Style="{DynamicResource TopPanelNotificationsToggle}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                                    <Grid MaxWidth="260">
                                        <ProgressBar Name="PART_ProgressGlobal" Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
                                        <TextBlock Name="PART_TextProgressText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Style="{DynamicResource BaseTextBlockStyle}" Margin="8,2,8,2" />
                                    </Grid>
                                    <Button Name="PART_ButtonProgressCancel" VerticalAlignment="Center" Content="{DynamicResource LOCCancelLabel}"
                                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="4,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Auto-hide (TopPanelAutoHide): a thin strip until the mouse is over it or it has the keyboard focus -->
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{PluginSettings Plugin=LayoutStudio, Path=Options[TopPanelAutoHide], FallbackValue=False, TargetNullValue=False}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False" />
                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <!-- From is required: MaxWidth/MaxHeight start at Infinity, which cannot be animated.
                     Leaving the condition removes the storyboard, so the panel comes back at once. -->
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="HndTopPanelHide">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" From="110" To="10" BeginTime="0:0:0.6" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="HndTopPanelHide" />
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <!-- Readable over any artwork: near-white glyph (add-on pictures keep their colors), tight dark halo and a light dark pad -->
        <Setter Property="Foreground" Value="{DynamicResource SidebarIconBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0,0,0,0" />
        <Setter Property="Width" Value="{DynamicResource SidebarItemSize}" />
        <Setter Property="Height" Value="{DynamicResource SidebarItemSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid>
                        <ProgressBar x:Name="PART_ProgressStatus"
                                     Margin="2,0,2,0"
                                     BorderThickness="0" Background="{DynamicResource TopPanelItemForegroundBrush}"
                                     Foreground="{DynamicResource GlyphBrush}"
                                     Height="3"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Value, ElementName=PART_ProgressStatus}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Value, ElementName=PART_ProgressStatus}" Value="100">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <!-- selected: soft accent bloom, static (no animation, no effect) -->
                        <Border x:Name="Bloom" Visibility="Collapsed" IsHitTestVisible="False" Margin="-6"
                                Background="{DynamicResource GlyphBrush}" Opacity="{DynamicResource GlassGlowOpacity}"
                                OpacityMask="{DynamicResource GlassGlowMask}" CornerRadius="{DynamicResource SidebarItemCornerRadius}" />
                        <!-- very light dark square behind the icon: the contrast floor on a bright artwork -->
                        <Border x:Name="IconPad" Margin="3" IsHitTestVisible="False" CornerRadius="6"
                                Background="{DynamicResource SidebarIconPadBrush}" />
                        <Border x:Name="Pill" Margin="2" CornerRadius="{DynamicResource SidebarItemCornerRadius}" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="{DynamicResource GlassRimThickness}" />
                        <Border x:Name="Accent" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Width="3" Height="18" CornerRadius="2" Background="{DynamicResource GlyphBrush}" />
                        <Border Background="{TemplateBinding Background}"
                                Padding="{Binding IconPadding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#000000" ShadowDepth="0" BlurRadius="3" Opacity="0.9" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=LayoutStudio, Path=Options[SidebarIconHalo], FallbackValue=True, TargetNullValue=True}" Value="False">
                                            <Setter Property="Effect" Value="{x:Null}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Viewbox>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource GlassHoverFillBrush}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource GlassRimBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource GlassSelectionFillBrush}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource GlassRimBrush}" />
                            <Setter TargetName="IconPad" Property="Background" Value="{DynamicResource SidebarIconActivePadBrush}" />
                            <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- sidebar on the top or bottom edge: the accent bar lies under the icon instead of beside it -->
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter TargetName="Accent" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Accent" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="Accent" Property="Width" Value="18" />
                            <Setter TargetName="Accent" Property="Height" Value="3" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter TargetName="Accent" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Accent" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="Accent" Property="Width" Value="18" />
                            <Setter TargetName="Accent" Property="Height" Value="3" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TopPanelItemIsMouseOverForegroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarIconActiveBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                <Setter Property="Margin" Value="0,0,0,5" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Margin" Value="0,0,5,0" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Margin" Value="0,0,5,0" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="OrangeRed" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
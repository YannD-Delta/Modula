<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource SearchBoxBackgroundBrush}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Grid x:Name="FocusBloom" Opacity="0" IsHitTestVisible="False" Margin="{DynamicResource GlassGlowMargin}">
                            <Border Background="{DynamicResource GlyphBrush}" Opacity="{DynamicResource GlassGlowOpacity}"
                                    OpacityMask="{DynamicResource GlassGlowMask}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        </Grid>
                        <Border Name="Border" Background="{TemplateBinding Background}" Opacity="{DynamicResource SearchBoxGlassOpacity}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border BorderBrush="{DynamicResource GlassInsetRimBrush}" BorderThickness="{DynamicResource GlassRimThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <Border x:Name="FocusRing" BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1.5" Opacity="0"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <Grid>
                            <ContentControl x:Name="PART_SeachIcon"
                                            IsHitTestVisible="False"
                                            ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"
                                            Foreground="{DynamicResource TextBrushDarker}" />
                            <TextBox x:Name="PART_TextInpuText" Background="Transparent" BorderThickness="0"
                                     VerticalContentAlignment="Center" Padding="8,0,25,0"/>
                            <ContentControl x:Name="PART_ClearTextIcon"
                                            Cursor="Hand"
                                            ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                            FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"
                                            Foreground="{DynamicResource TextBrushDarker}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SearchBoxIsMouseOverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SearchBoxIsMouseOverBackgroundBrush}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            <Setter TargetName="FocusBloom" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>